# 察元 AI — 网络部署环境变量样例(docker-compose.network.yaml 用)
# ====================================================================
# 用法:
#   cd docker
#   cp .env.network.example .env
#   编辑 .env 填密钥/密码
#   docker compose -f docker-compose.network.yaml up -d
#
# .env 由 docker compose 自动读取;已在 .gitignore,不会进 git。
# ====================================================================

# ── 可选(推荐):JWT 签名密钥 ────────────────────────────────────
# 留空也能跑:首次 init 会随机生成并持久化到 ./data,server/worker 共享一致。
# 想固定密钥 / 多机一致 / 升级不掉登录态时,在这里设一个长随机串。
# 生成:openssl rand -hex 64
JWT_SECRET=

# ── PostgreSQL 密码 ─────────────────────────────────────────────
# postgres 容器与 chayuan 连接串共用此值,改这里两边同时生效。
POSTGRES_PASSWORD=chayuan

# ── 初始管理员 ──────────────────────────────────────────────────
# 首次启动若库里没用户,按此建管理员账号。
# 密码留空 = 随机生成并打到启动日志:docker compose -f docker-compose.network.yaml logs chayuan-server
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 前端端口(宿主侧)───────────────────────────────────────────
# 浏览器入口 http://<host>:<这个端口>/ ;冲突时改这里。
CHAYUAN_WEB_PORT=8080
