# 察元 AI — 网络部署环境变量样例(docker-compose.network.yaml 用)
# ====================================================================
# 本 compose【不预配置】察元到基础设施的连接(连接进 /admin 后台配)。
# 这里只是基础设施容器自身的账号/端口,以及前端端口。
#
# 用法:cd docker && cp .env.network.example .env && 按需改 → up -d
# .env 已在 .gitignore,不会进 git。
# ====================================================================

# ── PostgreSQL 容器账号 ────────────────────────────────────────
# 进 /admin「数据库」配置时,host 填 postgres、端口 5432、库/账号/密码用下面这组。
POSTGRES_USER=chayuan
POSTGRES_PASSWORD=chayuan
POSTGRES_DB=chayuan

# ── MinIO 容器账号(Milvus 依赖;若兼作察元对象存储,后台 endpoint 填 minio:9000)──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── 前端端口(宿主侧)──────────────────────────────────────────
# 浏览器入口 http://<host>:<这个端口>/ ;冲突时改这里。
CHAYUAN_WEB_PORT=8080
