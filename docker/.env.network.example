# 察元 AI — 网络部署环境变量样例(docker-compose.network.yaml 用)
# ====================================================================
# 开箱即用:基础设施默认已配好,不填 .env 也能 up。下面都是可选覆盖项。
# cp .env.network.example .env 后按需改。.env 已在 .gitignore。
# ====================================================================

# ── 前端端口(宿主侧)── 浏览器入口 http://<host>:<这个端口>/
# 端口遵循原有约定,默认 8080。(62581 后端 API 固定不可改,WPS 等都连它)
CHAYUAN_WEB_PORT=8080

# ── PostgreSQL(业务库)账号 ── 容器与察元连接共用
POSTGRES_USER=chayuan
POSTGRES_PASSWORD=chayuan
POSTGRES_DB=chayuan

# ── MinIO(对象存储)账号 ── 容器与察元连接共用(也是 Milvus 的后端存储)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── JWT 签名密钥(可选)── 留空 init 随机生成并持久化;想固定/多机一致就设
# 生成:openssl rand -hex 64
JWT_SECRET=

# ── MySQL(可选,换业务库时用)── 需先放开 compose 里的 mysql 服务
# MYSQL_ROOT_PASSWORD=root
# MYSQL_USER=chayuan
# MYSQL_PASSWORD=chayuan
# MYSQL_DB=chayuan

# ── 察元镜像名 / 版本(可选)── 默认 chayuan:latest
# 推到外部仓库时:CHAYUAN_IMAGE=registry.example.com/chayuan、CHAYUAN_TAG=2.0.227
# CHAYUAN_IMAGE=chayuan
# CHAYUAN_TAG=latest
