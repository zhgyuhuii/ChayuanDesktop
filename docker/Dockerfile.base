# syntax=docker/dockerfile:1.6
# ====================================================================
# 察元 基础环境镜像 — 系统依赖 + Python 依赖(极少变动)
# --------------------------------------------------------------------
# 只在 **poetry.lock 变化**(依赖增删/升级)时才需重建;业务代码改动、version bump
# 都**不影响**本镜像。由 docker/build.sh 自动按 poetry.lock 哈希 tag + 复用,
# 平时主镜像重建零依赖拉取。
#
# 单独构建(一般不用手动,交给 build.sh):
#   docker build -f docker/Dockerfile.base -t chayuan-base:latest .   (context=repo 根)
# ====================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR=/tmp/poetry-cache \
    DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# 系统依赖(集成镜像:含 nginx;sidecar/ffmpeg/faiss 运行时库)
#   build-essential / libgomp1 / libstdc++6 libgcc-s1 / ffmpeg libsndfile1 /
#   libmagic1 / nginx-light / curl git ca-certificates tini
# apt 国内加速:python:slim 默认 deb.debian.org 在国内极慢(实测 apt 步 >1h)。
# 默认换阿里云 Debian 镜像;海外构建可 --build-arg APT_MIRROR=deb.debian.org 还原,
# 或 --build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn 等。空字符串=不改源。
ARG APT_MIRROR=mirrors.aliyun.com
RUN if [ -n "$APT_MIRROR" ]; then \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
            [ -f "$f" ] && sed -i "s|deb.debian.org|$APT_MIRROR|g; s|security.debian.org|$APT_MIRROR|g" "$f" || true; \
        done; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 libstdc++6 libgcc-s1 \
        ffmpeg libsndfile1 \
        libmagic1 \
        nginx-light \
        curl git ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* /var/log/nginx/*

# PyPI 国内加速:python:slim 默认走 pypi.org,国内拉 wheel 极慢/超时,pip resolver 会一路
# 回退到远古 cryptography 2.6 源码包再编译,在 py3.12 新 setuptools 下因缺 pkg_resources 直接
# 炸(ModuleNotFoundError: No module named 'pkg_resources')。默认换阿里云 PyPI 镜像(与 apt
# 一致);海外构建 --build-arg PIP_INDEX_URL= 还原 pypi.org,或传 tuna 等其它镜像。设成 ENV,让
# 本层 pip、下面 minio 那行、以及 FROM 本镜像的应用镜像都自动继承,无需逐行 -i。
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# poetry 必须 >= 生成 poetry.lock 的版本(当前 lock 由 2.4.1 生成);低版本(2.2.0)
# 读不懂 content-hash 会误判 "pyproject changed significantly" 而失败。
RUN pip install --no-cache-dir poetry==2.4.1

WORKDIR /chayuan/app/chayuan-server/libs/chayuan-server
# 只 COPY 依赖声明(不 COPY app 源码)→ 本镜像不随业务代码/version 变。
# version 字段不进 poetry content-hash,bump 不会让本层失配。
COPY chayuan-server/libs/chayuan-server/pyproject.toml ./
COPY chayuan-server/libs/chayuan-server/poetry.lock* ./
# ── poetry 安装 + torch CUDA→CPU(必须同一个 RUN 层!)──────────────
# ⚠ Docker 分层语义:镜像大小是所有层累加。若在「后续 RUN」里 pip uninstall
# 掉 poetry 装的 CUDA torch,被删文件仍躺在 poetry install 那层里计入总大小
# (只多加一层 whiteout + CPU torch),镜像反而更大(实测 11.23→12.62GB)。
# 所以 torch 替换必须和 poetry install 在【同一个 RUN】:同层内创建又删除的
# CUDA 字节不进最终 layer diff,镜像才真正从 ~11GB 降到 ~4GB。
# poetry 默认源 torch 2.11.0 是 CUDA 版,拖 16 个 nvidia-cu13 库(~7-8GB);服务器
# 无 GPU 用不到。桌面打包早用 torch+cpu。【不改 pyproject/poetry.lock,只 pip 层替换】。
# 国内拉 download.pytorch.org 慢时:--build-arg TORCH_CPU_INDEX=<国内 cpu 镜像>。
ARG TORCH_CPU_INDEX=https://download.pytorch.org/whl/cpu
RUN --mount=type=cache,target=/tmp/poetry-cache \
    ( poetry install --only main --no-root \
      || ( echo "[build.base] poetry.lock 失配,镜像内重锁..." && poetry lock && poetry install --only main --no-root ) ) \
 && ( pip uninstall -y torch triton \
        nvidia-cublas-cu13 nvidia-cuda-cupti-cu13 nvidia-cuda-nvrtc-cu13 \
        nvidia-cuda-runtime-cu13 nvidia-cudnn-cu13 nvidia-cufft-cu13 nvidia-cufile-cu13 \
        nvidia-curand-cu13 nvidia-cusolver-cu13 nvidia-cusparse-cu13 nvidia-cusparselt-cu13 \
        nvidia-nccl-cu13 nvidia-nvjitlink-cu13 nvidia-nvshmem-cu13 nvidia-nvtx-cu13 \
        2>/dev/null || true ) \
 && pip install --no-cache-dir "torch==2.11.0+cpu" --index-url "${TORCH_CPU_INDEX}" \
 && python -c "import torch; assert torch.version.cuda is None, torch.version.cuda; print('[base] torch', torch.__version__, 'cuda=', torch.version.cuda)"

# 对象存储 minio 客户端:poetry main 不含此 optional extra(storage-minio),这里显式
# 预装进 base,主镜像 FROM 继承即可 —— 改业务代码重建主镜像时【零拉取】,根治"每次
# 打镜像都重新下载 minio / argon2-cffi / pycryptodome"。子依赖随之一并固化进 base。
# index 已由上面 ENV PIP_INDEX_URL 统一驱动(默认阿里云),这里不再逐行 -i。
RUN pip install --no-cache-dir "minio>=7.2,<8.0"

# build.sh 写入本 base 对应的 poetry.lock 哈希,便于排查复用命中
ARG LOCK_HASH=unknown
LABEL chayuan.base.lock_hash=$LOCK_HASH
