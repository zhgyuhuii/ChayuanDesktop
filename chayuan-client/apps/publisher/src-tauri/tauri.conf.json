{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "察元发布客户端",
  "version": "2.0.186",
  "identifier": "com.chayuan.publisher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3921",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "察元发布客户端",
        "width": 980,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  }
}
