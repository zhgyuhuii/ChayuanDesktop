{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "../../packages/*/src"],
  "exclude": [
    "**/node_modules",
    "../../packages/*/src/**/__tests__/**",
    "../../packages/*/src/**/*.test.ts",
    "../../packages/*/src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
