# ----------------------------------------------------------------------
# Langfuse 自托管 .env 模板
# 使用：cp .env.example .env 然后把下面几项都改了（不能用默认值）
# ----------------------------------------------------------------------

# PostgreSQL 密码（容器内）
LANGFUSE_DB_PASSWORD=langfuse_strong_pw_please_change

# NextAuth URL - 若你外部通过域名访问，改成 https://langfuse.yourcorp.com
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# NextAuth 密钥 - 必须换：`openssl rand -hex 32`
LANGFUSE_NEXTAUTH_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32_output

# Salt  - 同上
LANGFUSE_SALT=REPLACE_ME_WITH_openssl_rand_hex_32_output_different_value
