# chayuan 生产 docker-compose 环境变量示例
# 拷贝为 .env 后按需修改。切勿把真实密码提交到 git。

# 数据卷宿主机路径
CHAYUAN_DATA_DIR=/data/chayuan
PG_DATA_DIR=/data/chayuan-pg
REDIS_DATA_DIR=/data/chayuan-redis
MILVUS_DATA_DIR=/data/chayuan-milvus

# Postgres
POSTGRES_USER=chayuan
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=chayuan

# chayuan 镜像（或替换为你 CI 产物）
# 版本号对齐 libs/chayuan-server/pyproject.toml 的 version（SSOT）。
CHAYUAN_IMAGE=chayuan-server:1.0.0.0

# vLLM 模型（需事先下载或让 vLLM 运行时去拉）
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_SERVED_NAME=qwen2.5-14b

# TEI 嵌入模型
TEI_MODEL=BAAI/bge-m3

# 外网访问域名（nginx 证书的 CN / SAN）
PUBLIC_DOMAIN=chayuan.example.com
