# 拷贝为 .env，按需修改。
# 带 :? 的 env（JWT_SECRET）必须设，否则 compose 会拒绝启动。

# ---------- 镜像 ----------
CHAYUAN_IMAGE_TAG=local

# ---------- 数据库 ----------
POSTGRES_USER=chayuan
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=chayuan

# ---------- Milvus minio ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio

# ---------- 鉴权 ----------
# 生产必须改成强随机（48+ 字节），可用：openssl rand -base64 48
JWT_SECRET=please-replace-with-openssl-rand-base64-48-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 端口映射到宿主机 ----------
API_PORT=7861
WEBUI_PORT=8501
PANEL_PORT=8502
