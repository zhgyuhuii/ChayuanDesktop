# 察元开发栈 — 所有基础服务凭据（见本目录 docker-compose.yml）
# ---------------------------------------------------------------------------
# 用法 1：./bootstrap-secrets.sh   # 将下方默认项写入 .env
# 用法 2：cp .env.example .env
# 然后： docker compose up -d
# ---------------------------------------------------------------------------
# 本地开发约定（非生产）：
#   - Redis 不设密码
#   - 主库 Postgres: postgres / postgres（chayuan + onlyoffice 共用此实例）
#   - MinIO: minioadmin / minioadmin
# docker compose 会加载本目录 .env。勿提交 .env（已在 .gitignore）。
#
# Langfuse 不在本栈，见 ../langfuse/.env.example

# ---------- PostgreSQL（主业务库，库名 chayuan）----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chayuan

# ---------- Redis（空 = 无密码）----------
REDIS_PASSWORD=

# ---------- MinIO ----------
# MinIO 2025-02+ 砍掉了 Console 上的 access key 管理 UI；这里启动时由
# minio-setup 用 mc 自动建一组 service account 给业务调用，免去手工 CLI。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
CHAYUAN_MINIO_AK=chayuan-app
CHAYUAN_MINIO_SK=chayuan-app-secret-change-me-32

# ---------- OnlyOffice Document Server（--profile onlyoffice / full）----------
# 复用主 postgres 容器；启动时由 onlyoffice-pg-init 自动建库 + 角色
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASSWORD=onlyoffice
# 浏览器访问 Document Server 的地址。
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:8080
# chayuan-server 调 OnlyOffice CommandService / 下载保存结果的地址。
ONLYOFFICE_INTERNAL_URL=http://127.0.0.1:8080
# OnlyOffice 容器回访 chayuan-server 的地址；Linux 依赖 compose 里的 extra_hosts。
CHAYUAN_PUBLIC_URL=http://host.docker.internal:7861
# JWT 验签：本地开发先关。生产改 true 并填强随机 secret（openssl rand -hex 32）。
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=
# 本地开发允许 OnlyOffice 拉取 host.docker.internal / 私网地址；生产建议改公网 HTTPS + JWT 后关闭。
ONLYOFFICE_ALLOW_PRIVATE_IP_ADDRESS=true
ONLYOFFICE_ALLOW_META_IP_ADDRESS=true
