# 复制为 .env 后修改。所有 *_PASSWORD 字段建议用：
#   openssl rand -base64 24
# 生成 24+ 字符高熵值。
#
# 端口默认与 chayuan/server/runtime/vendor_loader.py 中的 KNOWN_SERVICES 对齐
# （5432→35432、6379→36379、9000→39000、19530→39530、11434→31434）。
# 任何端口被占用，PortAllocator 在 chayuan 启动时会自动改写到 runtime.json，
# 这里写"偏好值"即可。

# ---- 端口 ----
CHAYUAN_PG_PORT=35432
CHAYUAN_REDIS_PORT=36379
CHAYUAN_MINIO_PORT=39000
CHAYUAN_MINIO_CONSOLE_PORT=39001
CHAYUAN_MILVUS_PORT=39530
CHAYUAN_MILVUS_METRICS_PORT=39091
CHAYUAN_OLLAMA_PORT=31434

# ---- Postgres ----
POSTGRES_USER=chayuan
POSTGRES_PASSWORD=chayuan_change_me_24chars_min_xxx
POSTGRES_DB=chayuan

# ---- MinIO ----
MINIO_ROOT_USER=chayuan_minio
MINIO_ROOT_PASSWORD=minio_change_me_24chars_min_xxx

# ---- Redis（默认无密码；如需开启把下行注释解开并填值） ----
#REDIS_PASSWORD=redis_change_me_24chars_min_xxx
